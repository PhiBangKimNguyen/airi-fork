# Point to an existing key file, or put API keys in this .env.
AIRI_KEYS_ENV="F:/Nec Download/SillyTavernSelfMod/.env"
NVIDIA_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY=
KIMI_MODEL=moonshotai/kimi-k3
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=medium
GEMINI_MEDIA_REASONING_EFFORT=medium
# Leave empty to use GEMINI_MODEL for media reactions.
GEMINI_MEDIA_MODEL=

# Use the existing local server. No model or server changes occur.
LOCAL_QWEN_BASE_URL=http://127.0.0.1:11434/v1/
LOCAL_QWEN_MODEL=
LOCAL_QWEN_API_KEY=
LOCAL_QWEN_REASONING_EFFORT=none
LOCAL_VISION_BASE_URL=http://127.0.0.1:11434/v1/
LOCAL_VISION_MODEL=
LOCAL_VISION_API_KEY=
# For Japanese speech, use voicevox with LOCAL_TTS_VOICE=60 (VOICEVOX:猫使ビィ, 人見知り).
LOCAL_TTS_VOICE=af_heart
LOCAL_TTS_PROVIDER=kokoro
LOCAL_VOICEVOX_PORT=50021
# ja-en displays Japanese with a parenthesized English translation. Speech stays Japanese.
LOCAL_REPLY_LANGUAGE=ja-en

AIRI_GATEWAY_PORT=18420
AIRI_ENABLE_LOCAL_ASR=false
# Off by default. Enable only for intentionally shared cloud video frames and captions.
AIRI_CLOUD_VIDEO_VISION=false
# Public shared-tab audio only. Private mode disables hosted audio perception.
AIRI_AUDIO_EARS=false
AIRI_GATEWAY_TOKEN=

# Hosted roles use the existing key file. Enable GLM without replacing local privacy routing.
AIRI_MODEL_ROLES_ENABLED=true
AIRI_CONTEXT_MESSAGES=12
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
GROQ_API_KEY=
AIRI_BRAIN_PROVIDER=cloudflare
AIRI_BRAIN_MODEL=@cf/zai-org/glm-4.7-flash
AIRI_BRAIN_MAX_TOKENS=2048
AIRI_BRAIN_AMBIENT_MAX_TOKENS=1024
AIRI_BRAIN_TIMEOUT_MS=12000
AIRI_BRAIN_THINKING=false
AIRI_VISION_PROVIDER=cloudflare
AIRI_VISION_MODEL=@cf/qwen/qwen3.8-27b
AIRI_VISION_MAX_TOKENS=1024
AIRI_VISION_TIMEOUT_MS=8000
AIRI_REASONING_PROVIDER=groq
AIRI_REASONING_MODEL=qwen/qwen3.8-27b
AIRI_REASONING_MAX_TOKENS=4096
AIRI_REASONING_TIMEOUT_MS=30000
AIRI_REASONING_REASONING_EFFORT=medium
AIRI_HEAVY_REASONING_ENABLED=true
AIRI_HEAVY_REASONING_PROVIDER=groq
AIRI_HEAVY_REASONING_MODEL=openai/gpt-oss-120b
AIRI_HEAVY_REASONING_MAX_TOKENS=8192
AIRI_HEAVY_REASONING_TIMEOUT_MS=45000
AIRI_HEAVY_REASONING_REASONING_EFFORT=high
AIRI_LOCAL_FALLBACK_PROVIDER=local
# Leave empty to retain LOCAL_QWEN_MODEL. Point to an installed Qwen3.5-9B model when available.
AIRI_LOCAL_FALLBACK_MODEL=
AIRI_LOCAL_FALLBACK_MAX_TOKENS=2048
AIRI_LOCAL_FALLBACK_TIMEOUT_MS=15000
# Optional public character prompt. Private character cards and memories stay local.
AIRI_PUBLIC_CHARACTER_PROMPT=
